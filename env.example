# App
SIPM_DISABLE_STARTUP=false
SIPM_DISABLE_THREADPOOL=false
SIPM_KEEPALIVE_TASK=false

# Auth
SIPM_SECRET_KEY=dev-secret-change-me
SIPM_ACCESS_MINUTES=60
SIPM_REFRESH_DAYS=7
SIPM_RESET_MINUTES=30
SIPM_SECURE_COOKIES=false
SIPM_COOKIE_SAMESITE=lax
SIPM_BCRYPT_ROUNDS=12

# Database
SIPM_DB_PROFILE=dev
SIPM_DATABASE_URL=sqlite:///data/jira_lite.db
SIPM_DATABASE_URL_DEV=sqlite:///data/jira_lite.dev.db
SIPM_DATABASE_URL_UAT=sqlite:///data/jira_lite.uat.db
SIPM_DATABASE_URL_PROD=sqlite:///data/jira_lite.prod.db

# AI / GenAI
GENAI_MODEL=gemini-3-flash-preview
# Optional auth mode (no API key): Vertex + ADC
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
GENAI_DEBUG=true
AI_DEBUG_TRACE=true
AI_MAX_STEPS=30
AI_MAX_TOOL_CALLS=12
AI_MAX_CONTEXT_CALLS=4
AI_CONTEXT_HISTORY_LIMIT=200
AI_MODEL_TIMEOUT_SECONDS=120
AI_WALL_TIMEOUT_SECONDS=120

# # AI prompts/contracts
# SIPM_PROMPTS_DIR=
# SIPM_CONTRACTS_DIR=

# Documents
SIPM_DOC_STORAGE=data/external_docs
