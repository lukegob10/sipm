{
  "entity": "solution",
  "fields": {
    "solution_id": {"type": "string", "read_only": true},
    "project_id": {"type": "string", "description": "Parent project id."},
    "solution_name": {"type": "string", "description": "Solution name."},
    "version": {"type": "string", "description": "Solution version.", "default": "0.1.0"},
    "status": {"type": "enum", "enum": "SolutionStatus", "default": "not_started"},
    "rag_status": {"type": "enum", "enum": "RagStatus", "default": "green"},
    "rag_reason": {"type": "string"},
    "priority": {"type": "integer", "min": 0, "max": 5, "default": 3},
    "due_date": {"type": "date"},
    "current_phase": {"type": "string"},
    "description": {"type": "string"},
    "success_criteria": {"type": "string"},
    "problem_statement": {"type": "string"},
    "blockers": {"type": "string"},
    "risks": {"type": "string"},
    "owner": {"type": "string", "default": "$CURRENT_USER_DISPLAY_NAME"},
    "owner_user_soeid": {"type": "string", "default": "$CURRENT_USER_SOEID"},
    "assignee": {"type": "string"},
    "assignee_user_soeid": {"type": "string"},
    "approver": {"type": "string"},
    "approver_user_soeid": {"type": "string"},
    "key_stakeholder": {"type": "string"},
    "capacity_hours": {"type": "integer", "min": 0, "default": 0},
    "impact_confidence": {"type": "enum", "enum": "ConfidenceLevel"},
    "planned_start_date": {"type": "date"},
    "rag_confidence": {"type": "float", "min": 0, "max": 1},
    "completed_at": {"type": "datetime", "read_only": true}
  },
  "required": ["project_id", "solution_name"],
  "optional": [
    "version",
    "status",
    "rag_status",
    "rag_reason",
    "priority",
    "due_date",
    "current_phase",
    "description",
    "success_criteria",
    "problem_statement",
    "blockers",
    "risks",
    "owner",
    "owner_user_soeid",
    "assignee",
    "assignee_user_soeid",
    "approver",
    "approver_user_soeid",
    "key_stakeholder",
    "capacity_hours",
    "impact_confidence",
    "planned_start_date",
    "rag_confidence"
  ],
  "constraints": {
    "priority": {"min": 0, "max": 5},
    "capacity_hours": {"min": 0},
    "status": {"enum": "SolutionStatus"},
    "rag_status": {"enum": "RagStatus"},
    "impact_confidence": {"enum": "ConfidenceLevel"},
    "rag_confidence": {"min": 0, "max": 1}
  },
  "relationships": {
    "project_id": "project"
  }
}
