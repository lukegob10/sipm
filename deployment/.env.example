# Image, build, and port wiring.
COMPOSE_PROJECT_NAME=sipm
SIPM_IMAGE=sipm:homelab
SIPM_CONTAINER_NAME=sipm
SIPM_REDIS_CONTAINER_NAME=sipm-redis
INSTALL_TREASURY_ANALYTICS_MOCK=true
TREASURY_ANALYTICS_PACKAGE=
SIPM_HOST_PORT=8000

# Runtime profile
# Use ENV=dev for HTTP-only home-lab deployment. Non-dev profiles require
# SIPM_SECURE_COOKIES=true, which requires HTTPS for browser logins.
ENV=dev
SIPM_CONTEXT_PATH=/project-manager

# Auth and cookies
SIPM_SECRET_KEY=replace-with-a-long-random-secret
SIPM_ALLOW_SELF_REGISTER=false
SIPM_SECURE_COOKIES=false
SIPM_COOKIE_SAMESITE=lax
SIPM_ACCESS_MINUTES=30
SIPM_REFRESH_DAYS=7
SIPM_RESET_MINUTES=30
SIPM_ONE_TIME_RESET_MINUTES=30
SIPM_BCRYPT_ROUNDS=12

# Runtime toggles
SIPM_DISABLE_STARTUP=false
SIPM_DISABLE_THREADPOOL=false
SIPM_KEEPALIVE_TASK=false
SIPM_ENV_OVERRIDE=false
SIPM_USAGE_ANALYTICS_ENABLED=false

# DB pool
SIPM_DB_POOL_SIZE=5
SIPM_DB_MAX_OVERFLOW=10
SIPM_DB_POOL_TIMEOUT_SECONDS=30
SIPM_DB_POOL_RECYCLE_SECONDS=1800
SIPM_DB_POOL_PRE_PING=true
SIPM_DB_POOL_USE_LIFO=false
SIPM_DB_PREWARM_ON_STARTUP=false
SIPM_DB_PREWARM_CONNECTIONS=1
SIPM_DB_KEEPWARM_INTERVAL_SECONDS=0

# Cache and realtime
SIPM_REDIS_TIMEOUT_SECONDS=5
SIPM_SMART_CACHE_ENABLED=true
SIPM_SMART_CACHE_MAX_ENTRIES=4096
SIPM_WS_MAX_CONNECTIONS_GLOBAL=400
SIPM_WS_MAX_CONNECTIONS_PER_USER=8
SIPM_WS_IDLE_TIMEOUT_SECONDS=600

# Domain defaults
DOMAIN_NAME=citi.com

# TA/Oracle runtime
# Corporate-style builds should install the real treasury_analytics package.
# Home-lab rehearsal builds can install the local mock package; it delegates to
# oracledb and reads these variables.
TA_DEV_DSN=host.docker.internal:1521/FREEPDB1
TA_DEV_USER=app_user
TA_DEV_PASSWORD=replace-with-home-lab-db-password

# Documents
SIPM_DOC_STORAGE=data/external_docs
